FROM node:14.18-alpine AS builder
RUN echo -e "http://mirrors.aliyun.com/alpine/v3.11/main\nhttp://mirrors.aliyun.com/alpine/v3.11/community" > /etc/apk/repositories && apk update
WORKDIR /WebsiteGuide
COPY websitefronted /WebsiteGuide/websitefronted
RUN cd /WebsiteGuide/websitefronted && npm config set registry https://registry.npmmirror.com && npm install && npm run build

FROM nginx:1.21-alpine
RUN echo -e "http://mirrors.aliyun.com/alpine/v3.11/main\nhttp://mirrors.aliyun.com/alpine/v3.11/community" > /etc/apk/repositories && apk update
COPY --from=builder /WebsiteGuide/websitefronted/dist /usr/share/nginx/html
ADD websitefronted/tools/Docker/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 8098
ENTRYPOINT ["nginx","-g","daemon off;"]
