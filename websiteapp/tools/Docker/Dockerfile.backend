FROM python:3.6.10-alpine3.11

RUN echo -e "http://mirrors.aliyun.com/alpine/v3.11/main\nhttp://mirrors.aliyun.com/alpine/v3.11/community" > /etc/apk/repositories \
    && apk add -U tzdata \
    && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime
RUN apk update && apk add --no-cache build-base bash
RUN apk add --no-cache --virtual .build-deps openssl-dev gcc musl-dev python3-dev libffi-dev make

WORKDIR /WebsiteGuide
COPY requirements.txt /WebsiteGuide/requirements.txt
RUN pip config set global.index-url https://pypi.mirrors.ustc.edu.cn/simple/ && pip install --upgrade pip && pip install --no-cache-dir -r /WebsiteGuide/requirements.txt && pip install --no-cache-dir gunicorn && apk del .build-deps
COPY . /WebsiteGuide
ADD websiteapp/tools/start-api.sh /WebsiteGuide/websiteapp/tools/start-api.sh
ADD websiteapp/tools/Docker/entrypoint-backend.sh /entrypoint-backend.sh

EXPOSE 8099
ENTRYPOINT ["sh", "/entrypoint-backend.sh"]
